{
  "schema_version": "root-teller-clean-integration-config-1.0",
  "dataset": "RCAEval RE2-OB",
  "condition": "CLEAN",
  "split": "held-out test",
  "module1": {
    "checkpoint_policy": "one refit checkpoint per outer fold and seed",
    "device": "cuda:0 when available",
    "window_seconds": 60,
    "availability_mask": true
  },
  "module2": {
    "protocol": "default-exhaustive",
    "consume_all_available_windows": true,
    "windows_per_case": 24,
    "overlap_seconds": 0,
    "prompt_version": "crt-re2ob-v2",
    "llm_model": "gpt-4o-mini",
    "temperature": 0.0,
    "max_validation_tasks_per_round": 2,
    "max_hierarchical_rounds": 2,
    "ranking_weights": {
      "deterministic": 0.8,
      "steward": 0.2
    }
  },
  "module3": {
    "prompt_version": "rca-interaction-v2",
    "verifier_budget": 3,
    "feedback_granularity": "service",
    "feedback_budget": 20,
    "feedback_score_decay": 0.9,
    "ground_truth_visible_to_agents": false
  },
  "selection_policy": {
    "parameters_selected_on_validation_only": true,
    "heldout_test_feedback_to_tuning": false,
    "feedback_study_isolated_from_overall_localization": true
  },
  "paper_result_source": "evaluation/rq1/results/paper_table.csv"
}

{
  "status": "paper-aligned public configuration",
  "dataset": "RCAEval RE2-OB",
  "split_manifest": "${ROOTTELLER_WORKSPACE}/artifact/telemetry_unavailability/manifests/split_manifest.csv",
  "outer_protocol": {
    "folds": 3,
    "development_cases_per_fold": 60,
    "test_cases_per_fold": 30,
    "group_repeated_injections": true,
    "test_feedback_to_tuning": false
  },
  "features": {
    "bin_seconds": 60,
    "metric_groups": [
      "cpu",
      "memory",
      "disk",
      "network",
      "socket",
      "request",
      "error",
      "latency",
      "bytes",
      "other"
    ],
    "log_template_parser": "drain_style_message_regex_v2",
    "log_embedding": "sentence-transformers/all-MiniLM-L6-v2",
    "log_embedding_dimension": 384,
    "log_count_features": 3,
    "trace_features": 6
  },
  "model": {
    "hidden_dimension": 48,
    "embedding_dimension": 48,
    "graph_layers": 2,
    "dropout": 0.2,
    "fusion_lambda": 0.6,
    "availability_mask": true,
    "structured_training_dropout": {
      "full_modality_probability": 0.25,
      "suffix_interruption_probability": 0.25
    }
  },
  "training": {
    "optimizer": "AdamW",
    "learning_rate": 0.001,
    "weight_decay": 0.0001,
    "gradient_clip_norm": 5.0,
    "batch_size": 1,
    "maximum_epochs": 300,
    "validation_interval_epochs": 5,
    "early_stopping_patience_epochs": 50,
    "seeds": [41, 42, 43],
    "refit_complete_outer_development_partition": true
  }
}
